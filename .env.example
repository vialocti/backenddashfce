# Copiar a .env y completar. El .env real no se versiona.

# Puerto HTTP de la API
PORT=

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Opcionales (valores por defecto entre parentesis)
# SCHEMA_ORIGEN=negocio
# SCHEMA_RENDIMIENTO=fce_per
# BIMESTRES_FIN_MES=4,6,9,11
# HABILITADO_TRUNCATE_DATOS_ALUINFO=false

# Firma de los JWT (middleware verificarToken)
JWT_SECRET=

# Clave del header x-orquestador-key; sin ella los orquestadores responden 503
ORQUESTADOR_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID_1=
OPENAI_ASSISTANT_ID_2=
OPENAI_ASSISTANT_ID_HELP=
VECTOR_STORE_ID=
VECTOR_STORE_ID_EQUI=
